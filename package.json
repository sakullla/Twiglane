{
  "name": "twiglane",
  "private": true,
  "version": "0.3.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:ui": "vite --config scripts/ui-preview/vite.config.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "tauri": "tauri",
    "fixture": "node scripts/generate-fixture.mjs",
    "measure": "node scripts/measure-delivery.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "benchmark:git": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features benchmarks --example benchmark-git --",
    "benchmark:status": "node scripts/benchmarks/status.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.3",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "entities": "7.0.1",
    "marked": "18.1.3",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.19.2",
    "happy-dom": "21.0.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

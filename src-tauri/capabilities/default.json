{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Twiglane 主窗口的最小权限：系统目录对话框与结构化 Git 命令，不包含 shell。",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "dialog:allow-open",
    "allow-detect-git",
    "allow-set-git-executable",
    "allow-clear-git-executable",
    "allow-get-settings",
    "allow-add-repository",
    "allow-create-repository",
    "allow-open-repository",
    "allow-close-repository",
    "allow-forget-recent",
    "allow-refresh-status",
    "allow-load-diff",
    "allow-stage-files",
    "allow-unstage-files",
    "allow-stage-hunks",
    "allow-commit-changes",
    "allow-clone-repository",
    "allow-remote-state",
    "allow-add-remote",
    "allow-set-remote-url",
    "allow-fetch-remote",
    "allow-pull-fast-forward",
    "allow-push-branch",
    "allow-publish-branch",
    "allow-associate-upstream",
    "allow-commit-and-push",
    "allow-branch-state",
    "allow-create-branch",
    "allow-switch-branch",
    "allow-delete-branch",
    "allow-delete-remote-branch",
    "allow-set-theme",
    "allow-set-panel-widths",
    "allow-save-draft"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twiglane",
  "version": "0.2.18",
  "identifier": "app.twiglane.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Twiglane",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "publisher": "Twiglane",
    "category": "DeveloperTool",
    "shortDescription": "Twiglane 轻量 Git 桌面客户端",
    "longDescription": "让每次改动，都清晰有序。安装包不包含 Git。Windows 安装器不包含 WebView2，缺失时另行下载，该下载不计入应用体积。未做公开发布签名或公证。",
    "copyright": "Unsigned test distribution",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "signCommand": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "customLanguageFiles": {
          "SimpChinese": "./windows/SimpChinese.nsh",
          "English": "./windows/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0MjhEMzlDMDM4OUNENkMKUldSc3pZa0RuTk1vSkNoTGV5MGMvQjA0WG13bmp1WDRrUTkzcmpFUjM1cTA1ZkhXQTN6aVZOSUcK",
      "endpoints": ["https://github.com/sakullla/Twiglane/releases/latest/download/latest.json"]
    }
  }
}
